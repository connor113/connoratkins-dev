---
// Divider.astro — a sketched hand-drawn rule.
// Two overlapping wavering paths so it reads like a pen-stroke with a
// parallel correction line, the way you'd draw a rule in a notebook.
export interface Props {
  /** Adjust vertical rhythm around the divider. */
  tight?: boolean;
}
const { tight = false } = Astro.props;
---
<div class={`divider ${tight ? 'is-tight' : ''}`} aria-hidden="true">
  <svg viewBox="0 0 600 18" preserveAspectRatio="none" role="presentation">
    <path
      d="M4 9
         C 60 6, 120 12, 180 9
         S 300 5, 360 10
         S 480 13, 540 8
         L 596 10"
      fill="none"
      stroke-width="1.3"
      stroke-linecap="round"
    />
    <path
      d="M10 12
         C 80 10, 170 14, 260 11
         S 430 9, 520 13"
      fill="none"
      stroke-width="0.9"
      stroke-linecap="round"
      opacity="0.5"
    />
  </svg>
</div>

<style>
  .divider {
    width: 100%;
    margin: 48px 0;
    pointer-events: none;
  }
  .divider.is-tight {
    margin: 24px 0;
  }
  .divider svg {
    display: block;
    width: 100%;
    height: 18px;
    overflow: visible;
  }
  .divider svg path {
    stroke: var(--rule);
  }
</style>
