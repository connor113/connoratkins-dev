---
// Figure.astro — image + handwritten-style caption.
// Usage: <Figure src="/figures/x.png" alt="fallback" caption="fig 1 · a note" />
export interface Props {
  src: string;
  alt: string;
  caption?: string;
  number?: string | number;
}
const { src, alt, caption, number } = Astro.props;
---
<figure class="figure">
  <img src={src} alt={alt} loading="lazy" />
  {(caption || number) && (
    <figcaption>
      {number && <span class="fig-number">fig {number}</span>}
      {number && caption && <span class="fig-sep"> &middot; </span>}
      {caption && <span class="fig-caption">{caption}</span>}
    </figcaption>
  )}
</figure>

<style>
  .figure {
    margin: 40px 0;
    text-align: center;
  }
  .figure img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }
  .figure figcaption {
    font-family: var(--font-hand);
    color: var(--muted);
    margin-top: 10px;
    font-size: 1.2rem;
    line-height: 1.3;
  }
  .fig-number {
    color: var(--accent);
  }
  .fig-sep {
    color: var(--muted);
  }
</style>
