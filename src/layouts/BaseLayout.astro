---
export interface Props {
  title: string;
  description?: string;
  /** When true, constrain content width to 680px (blog reading width). */
  narrow?: boolean;
}

const { title, description = "Connor Atkins — token engineering, time to build.", narrow = false } = Astro.props;

// Only emit the Plausible snippet when PUBLIC_ENABLE_ANALYTICS is the literal
// string "true". Astro inlines import.meta.env at build time, so this is a
// static conditional — no analytics noise during `npm run dev` unless the
// dev explicitly opts in.
const analyticsEnabled = import.meta.env.PUBLIC_ENABLE_ANALYTICS === "true";
const analyticsDomain = import.meta.env.PUBLIC_ANALYTICS_DOMAIN ?? "connoratkins.dev";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`.replace('//', '/')} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {analyticsEnabled && (
      <script
        defer
        data-domain={analyticsDomain}
        src="https://plausible.io/js/script.js"
      ></script>
    )}
  </head>
  <body class={narrow ? 'narrow' : 'centred'}>
    <main>
      <slot />
    </main>
    <style is:global>
      :root {
        --bg: #fafafa;
        --fg: #1a1a1a;
        --muted: #555;
        --rule: #e5e5e5;
        --accent: #0066CC;
        --font-body:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, system-ui,
          sans-serif;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0a0a0a;
          --fg: #e8e8e8;
          --muted: #999;
          --rule: #262626;
          --accent: #4d9fff;
        }
      }

      *, *::before, *::after { box-sizing: border-box; }

      html, body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font-body);
        font-size: 17px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      body {
        padding: 3rem 1.5rem 6rem;
      }

      main {
        margin: 0 auto;
      }

      body.narrow main {
        max-width: 680px;
      }

      body.centred main {
        max-width: 680px;
      }

      a {
        color: var(--accent);
        text-decoration: none;
        border-bottom: 1px solid transparent;
      }

      a:hover {
        border-bottom-color: var(--accent);
      }

      h1, h2, h3 {
        font-weight: 600;
        line-height: 1.25;
      }

      h1 { font-size: 2rem; margin: 0 0 0.25rem; }
      h2 { font-size: 1.3rem; margin: 2.5rem 0 0.75rem; }
      h3 { font-size: 1.05rem; margin: 1.75rem 0 0.5rem; }

      p { margin: 0 0 1rem; }

      hr {
        border: 0;
        border-top: 1px solid var(--rule);
        margin: 2.5rem 0;
      }

      img {
        max-width: 100%;
        height: auto;
      }

      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.9em;
      }

      .tagline {
        color: var(--muted);
        font-style: italic;
        margin: 0.25rem 0 2rem;
      }

      .nav {
        margin-top: 3rem;
        font-size: 0.95rem;
        color: var(--muted);
      }

      .nav a { margin-right: 1rem; }

      .post-list {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .post-list li {
        padding: 1rem 0;
        border-bottom: 1px solid var(--rule);
      }

      .post-list li:last-child { border-bottom: 0; }

      .post-list .date {
        color: var(--muted);
        font-size: 0.9rem;
        display: block;
        margin-top: 0.25rem;
      }

      .post-list .desc {
        color: var(--muted);
        font-size: 0.95rem;
        margin: 0.35rem 0 0;
      }

      .post-meta {
        color: var(--muted);
        font-size: 0.9rem;
        margin-bottom: 2rem;
      }
    </style>
  </body>
</html>
