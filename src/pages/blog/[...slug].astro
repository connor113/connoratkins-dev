---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };

const { post } = Astro.props;
const { Content } = await render(post);

const dateFmt = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`${post.data.title} — Connor Atkins`} description={post.data.description} narrow>
  <h1>{post.data.title}</h1>
  <p class="post-meta">{dateFmt.format(post.data.pubDate)}</p>
  <article>
    <Content />
  </article>
  <hr />
  <nav class="nav">
    <a href={`${base}/blog`.replace('//', '/')}>&larr; All posts</a>
    <a href={base.replace(/\/$/, '') || '/'}>Home</a>
  </nav>
</BaseLayout>
