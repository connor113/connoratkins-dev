---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const dateFmt = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const base = import.meta.env.BASE_URL;
const href = (id: string) => `${base}/blog/${id}`.replace('//', '/');
---
<BaseLayout title="Blog — Connor Atkins" narrow>
  <h1>Blog</h1>
  <p class="tagline">Notes on agents, pathology, and shipping.</p>

  {posts.length === 0 ? (
    <p>Nothing published yet — check back soon.</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={href(post.id)}><strong>{post.data.title}</strong></a>
          <span class="date">{dateFmt.format(post.data.pubDate)}</span>
          {post.data.description && <p class="desc">{post.data.description}</p>}
        </li>
      ))}
    </ul>
  )}

  <nav class="nav">
    <a href={base.replace(/\/$/, '') || '/'}>Home</a>
  </nav>
</BaseLayout>
