# Copy to .env.production (or set in the GitHub Pages build env) when you
# want analytics enabled. Left unset locally so `npm run dev` never pings
# Plausible.
#
# Only variables prefixed with PUBLIC_ are exposed to client-side code.

# Set to the literal string "true" to emit the Plausible snippet.
PUBLIC_ENABLE_ANALYTICS=false

# Domain registered in Plausible. Defaults to connoratkins.dev if unset.
PUBLIC_ANALYTICS_DOMAIN=connoratkins.dev
